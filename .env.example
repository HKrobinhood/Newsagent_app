# GlobalNewsAI Environment Configuration Template

# FastAPI Settings
PROJECT_NAME="GlobalNewsAI Backend"
API_V1_STR="/api/v1"
DEBUG=False

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=globalnewsai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/globalnewsai

# AI Agent LLM Provider (Google Gemini / OpenAI / Anthropic)
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-1.5-pro

# Web Search Provider (Tavily / Serper / Bing)
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=your_search_api_key_here

# Mapbox (Android / Map)
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
